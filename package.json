{
  "name": "slicyweb",
  "productName": "SlicyWeb",
  "version": "0.1.16",
  "private": true,
  "license": "UNLICENSED",
  "description": "SlicyWeb Smart Slicer",
  "main": "dist/electron/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/build/check-locales.mjs",
    "check:ipc": "node scripts/build/check-ipc-channels.mjs",
    "profiles:index": "node scripts/build/generate-profile-index.mjs",
    "lint": "eslint src tests vite.config.mts vitest.config.mts playwright.config.mts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" vite.config.mts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" vite.config.mts",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.14.5",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "~3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  }
}
